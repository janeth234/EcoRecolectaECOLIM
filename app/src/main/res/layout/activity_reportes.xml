<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_pantalla">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reporte de residuos"
            android:textColor="@color/blanco"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/blanco"
                android:padding="22dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Filtrar por fecha desde" android:textSize="13sp" android:textColor="@color/texto_oscuro"/>
                <Button
                    android:id="@+id/btnFechaDesde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:text="Seleccionar fecha"
                    android:textAllCaps="false"
                    android:textColor="@color/teal_700"
                    android:layout_marginBottom="10dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Filtrar por fecha hasta" android:textSize="13sp" android:textColor="@color/texto_oscuro"/>
                <Button
                    android:id="@+id/btnFechaHasta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:text="Seleccionar fecha"
                    android:textAllCaps="false"
                    android:textColor="@color/teal_700"
                    android:layout_marginBottom="10dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Filtrar por tipo de residuo" android:textSize="13sp" android:textColor="@color/texto_oscuro"/>
                <Spinner
                    android:id="@+id/spFiltroTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="18dp" />

                <Button
                    android:id="@+id/btnGenerar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_boton_verde"
                    android:text="Generar reporte"
                    android:textColor="@color/teal_900"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:layout_marginBottom="18dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/fondo"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:id="@+id/tvResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp"
                        android:text="Total: 0 kg&#10;Registros: 0" />
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnCompartir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_boton_verde"
                    android:text="Compartir reporte (PDF/CSV)"
                    android:textColor="@color/teal_900"
                    android:textStyle="bold"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnSincronizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:text="Sincronizar con servidor (API REST)"
                    android:textColor="@color/ambar_oscuro"
                    android:textAllCaps="false" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>